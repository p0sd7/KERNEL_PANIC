@startuml ActivityDiagram

start

:Инициализация ncurses;
:Загрузка CSV в DataStore;
:Создание сущности игрока;
:Установка ExplorationState;

repeat
    :InputSystem::pollEvents() → InputCommand;
    
    if (Команда QUIT?) then (да)
        :Game::quit();
        break;
    endif
    
    :current_state_->handleInput(cmd, data);
    
    if (Произошёл переход состояния?) then (да)
        :Game::changeState(new_state);
    else (нет)
        :current_state_->update(delta, data);
        
        if (Состояние == ExplorationState и show_inventory?) then (да)
            :RenderSystem::drawInventory(data, player_idx);
        endif
        
        if (Начат бой?) then (да)
            :Game::changeState(CombatState);
            note right
                Бой идёт в CombatState.
                Он сам обрабатывает ввод,
                вызывает CombatSystem,
                и по окончании вызывает
                Game::changeState(...)
            end note
        endif
        
        if (Текущее состояние == GameOverState?) then (да)
            :Ожидание любой клавиши;
            :Game::quit();
            break;
        endif
        
        if (Текущее состояние == FinalState и выбран ДА?) then (да)
            :Сброс PlayerData;
            :Game::changeState(ExplorationState);
        endif
    endif
    
    :RenderSystem::clear();
    :current_state_->draw(renderer, data);
    :RenderSystem::present();
    :sleep(16ms);

repeat while (running_ == true) is (да)
->нет;

:RenderSystem::shutdown();
stop

@enduml
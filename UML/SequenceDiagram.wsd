@startuml SequenceDiagram
title Sequence Diagram — Одна итерация игрового цикла KERNEL_PANIC

participant "Main/OS" as OS
participant "Game" as Game
participant "InputSystem" as Input
participant "current_state : IGameState" as State
participant "DataStore" as Data
participant "CombatSystem" as Combat
participant "RenderSystem" as Render

activate Game

note over Game : loop while (running)

Game -> Input: pollEvents()
activate Input
Input --> Game: InputCommand
deactivate Input

Game -> State: handleInput(cmd, data)
activate State

State -> Data: чтение/изменение сущностей
State -> State: внутренняя логика

alt Команда = MOVE и есть объект NPC
    State -> Game: changeState(DialogState)
    Game -> State: (состояние заменено)
else Команда = MOVE и есть объект BOSS
    State -> Game: changeState(CombatState)
    Game -> State: (состояние заменено)
else Команда = TEXT_INPUT (в CombatState)
    State -> Combat: applyScript(data, player_idx, script_id, enemy_indices, log)
    activate Combat
    Combat -> Data: чтение/изменение HP, эффектов
    Combat --> State: результат (победа/поражение)
    deactivate Combat
    alt победа
        State -> Game: changeState(ExplorationState)
    else поражение
        State -> Game: changeState(GameOverState)
    end
end

State --> Game
deactivate State

Game -> State: update(delta, data)
activate State
State -> Data: возможные изменения (например, восстановление после боя)
State --> Game
deactivate State

Game -> Render: clear()
Game -> State: draw(renderer, data)
activate State
State -> Render: drawExploration / drawCombat / drawDialog / drawInventory (если не CombatState)
State --> Game
deactivate State

Game -> Render: present()
Game -> OS: sleep(16ms)

note over Game : end loop

Game -> Render: shutdown()
deactivate Game

@enduml